# ============================================================
#  Vargod — пример конфигурации окружения.
#  Скопируйте в .env (он в .gitignore) и заполните своими значениями.
#    cp .env.example .env
#  Используется docker-compose и читается ConfigLoader на старте API/CLI.
# ============================================================

# --- PostgreSQL (контейнер db) ---
POSTGRES_DB=vargod
POSTGRES_USER=vargod
# В dev-режиме безопасно оставить заглушку. В production задайте сильный пароль.
POSTGRES_PASSWORD=vargod

# --- Подключение API/CLI к БД ---
# Внутри docker-compose host = db; локально — localhost.
DB_URL=jdbc:postgresql://db:5432/vargod
DB_USER=vargod
DB_PASSWORD=vargod

# --- ODE-симуляция ---
# Максимальный шаг интегрирования Dormand–Prince 5(4).
SIMULATION_MAX_STEP=1.0
SIMULATION_RELATIVE_TOLERANCE=1.0e-10
SIMULATION_ABSOLUTE_TOLERANCE=1.0e-10

# --- JWT (P1 — auth) ---
# 32+ случайных байта в base64 / hex. Сгенерировать локально:
#   openssl rand -base64 48
VARGOD_JWT_SECRET=change-me-to-a-real-long-random-secret-at-least-32-bytes
VARGOD_JWT_TTL_SECONDS=3600

# --- Bootstrap первого администратора (P1) ---
# При первом старте API создаёт пользователя с этим email+паролем и ролью ADMIN,
# если admin'ов ещё нет. Оставьте пустым, чтобы не создавать.
VARGOD_ADMIN_EMAIL=
VARGOD_ADMIN_PASSWORD=

# --- CORS ---
# Список origin'ов через запятую. * запрещён в production.
VARGOD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
