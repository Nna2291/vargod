<?xml version="1.0" encoding="UTF-8"?>
<!--
  Конфигурация системы логирования Vargod CLI (SLF4J + Logback).
  Все действия пользователя и все исключительные ситуации записываются
  в лог-файл logs/vargod.log.
  Уровни: TRACE/DEBUG — внутренние детали, INFO — действия пользователя и
  жизненный цикл приложения, WARN — ошибки валидации и доменные ошибки,
  ERROR — необработанные исключения.
-->
<configuration>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <!-- Все события прикладного уровня — в лог-файл с ротацией по размеру/дате -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/vargod.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/vargod-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{42} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- В консоль выводятся только ошибки, чтобы не засорять интерактивный REPL -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%-5level %logger{24} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Прикладной код Vargod логируется начиная с уровня DEBUG -->
    <logger name="com.vargod" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
