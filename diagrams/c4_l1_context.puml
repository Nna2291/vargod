@startuml c4_l1_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Context.puml

SHOW_LEGEND()

title Vargod — L1: Контекст системы

Person(researcher, "Исследователь", "Зарегистрированный пользователь.\nСоздаёт эксперименты, запускает симуляции,\nсравнивает результаты через веб-GUI.")
Person(guest, "Гость", "Неавторизованный пользователь.\nПросматривает каталог моделей\nи публичные эксперименты.")
Person(qa, "QA / разработчик", "Системное тестирование приложения\nчерез технологический UI (консоль).")

System(vargod, "Vargod", "Веб-платформа для численного моделирования\nбиологических систем на основе ОДУ.\nПозволяет запускать симуляции без написания кода.")

Rel(researcher, vargod, "Создаёт и запускает эксперименты")
Rel(guest, vargod, "Просматривает публичные данные")
Rel(qa, vargod, "Тестирует через технологический UI")

@enduml
