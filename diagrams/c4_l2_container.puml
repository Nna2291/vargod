@startuml c4_l2_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Container.puml

SHOW_LEGEND()

title Vargod — L2: Контейнеры

Person(researcher, "Исследователь")
Person(guest, "Гость")
Person(qa, "QA / разработчик", "Использует технологический UI\nдля системного тестирования")

System_Boundary(vargod, "Vargod") {
    Container(spa, "Web SPA", "TypeScript, React", "Интерфейс пользователя:\nкаталог моделей, форма параметров,\nграфик результатов, сравнение экспериментов.")

    Container(cli, "CLI Test UI", "Kotlin", "Технологический UI (Lab 5).\nКонсольный REPL для системного тестирования\nвсех Use Case через те же сервис-интерфейсы,\nна которых работает Web SPA.")

    Container(api, "API Server / Core", "Kotlin", "Сервисный слой (Lab 3) + JDBC-репозитории (Lab 4):\nуправление экспериментами, запуск ODE-симуляции,\nвалидация параметров, сравнение результатов.")

    ContainerDb(db, "База данных", "PostgreSQL", "Хранит пользователей, шаблоны моделей,\nэксперименты, наборы параметров,\nрезультаты симуляций, датасеты, валидаторы.")
}

Rel(researcher, spa, "Использует")
Rel(guest, spa, "Просматривает")
Rel(qa, cli, "Команды в REPL")
Rel(spa, api, "REST API")
Rel(cli, api, "Прямые вызовы сервис-интерфейсов\n(тот же компонент бизнес-логики)")
Rel(api, db, "Читает / записывает")

@enduml
