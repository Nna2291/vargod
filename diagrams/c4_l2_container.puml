@startuml c4_l2_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Container.puml

SHOW_LEGEND()

title Vargod — L2: Контейнеры и компоненты-сборки

Person(researcher, "Исследователь")
Person(guest, "Гость")
Person(qa, "QA / разработчик")

System_Boundary(vargod, "Vargod") {
    Container(spa, "Веб-GUI", "React, TypeScript, Vite + nginx", "Пользовательский графический интерфейс (SPA, паттерн MVVM):\nкаталог моделей, форма параметров, графики результатов, сравнение.")

    Container(cli, "Технологический UI", "Kotlin, app-cli", "Консольный REPL для системного тестирования\nвсех сценариев. Отдельная сборка-приложение.")

    Container(api, "API-сервер", "Kotlin, Spring Boot, api", "Компонент связи GUI и бизнес-логики:\nREST-контроллеры (Spring MVC).")

    Container(businessLogic, "Бизнес-логика", "Kotlin JAR, business-logic", "Сервисы предметной области + движки\nсимуляции ОДУ и валидации.\nОтдельная сборка-компонент.")

    Container(dataAccess, "Доступ к данным", "Kotlin JAR, data-access", "JDBC-репозитории, инициализация схемы,\nзаполнение БД. Отдельная сборка-компонент.")

    Container(domain, "Доменное ядро", "Kotlin JAR, domain", "Сущности, исключения, интерфейсы\nрепозиториев, загрузчик конфигурации.\nОбщая сборка-контракт.")

    ContainerDb(db, "База данных", "PostgreSQL 16", "Модели, эксперименты, параметры,\nрезультаты симуляций, сравнения.")
}

Rel(researcher, spa, "Использует", "HTTPS")
Rel(guest, spa, "Просматривает", "HTTPS")
Rel(qa, cli, "Команды REPL")

Rel(spa, api, "REST API", "JSON / HTTP")
Rel(api, businessLogic, "Вызывает сервисы")
Rel(api, dataAccess, "Связывает репозитории")
Rel(cli, businessLogic, "Вызывает сервисы")
Rel(cli, dataAccess, "Связывает репозитории")
Rel(businessLogic, domain, "Зависит от контрактов")
Rel(dataAccess, domain, "Реализует интерфейсы репозиториев")
Rel(dataAccess, db, "Читает / записывает", "JDBC")

note right of cli
  Логирование (SLF4J/Logback) → лог-файл.
  Конфигурирование → внешний vargod.properties.
end note

@enduml
