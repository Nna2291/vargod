@startuml c4_l3_component_backend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Component.puml

SHOW_LEGEND()

title Vargod — L3: Компоненты серверной части

Container(spa, "Веб-GUI", "React SPA", "Фронтенд")
ContainerDb(db, "PostgreSQL", "СУБД", "База данных")

Container_Boundary(api, "API-сервер (Spring Boot)") {
    Component(controllers, "REST-контроллеры", "Spring MVC, Kotlin", "ModelController, ExperimentController,\nComparisonController, SessionController.\nМаршрутизация HTTP, (де)сериализация JSON.")
    Component(exHandler, "ApiExceptionHandler", "Spring @RestControllerAdvice", "Единая обработка исключений:\nдоменные ошибки → HTTP-статусы, логирование.")
    Component(beansConfig, "ServiceConfig / WebConfig", "Spring @Configuration", "Корень композиции: собирает граф bean-ов\nиз компонентов бизнес-логики и доступа к данным. CORS.")
}

Container_Boundary(bl, "Компонент бизнес-логики") {
    Component(services, "Сервисы", "Kotlin", "ExperimentService, ModelService,\nComparisonService — оркестрация сценариев\nчерез интерфейсы (DIP).")
    Component(simulation, "Движок симуляции", "Kotlin + Apache Commons Math", "Численное решение систем ОДУ\nметодом Дорман–Принс 5(4).")
    Component(validation, "Движок валидации", "Kotlin", "RANGE- и CONSTRAINT-проверки\nпараметров эксперимента.")
}

Container_Boundary(da, "Компонент доступа к данным") {
    Component(repositories, "JDBC-репозитории", "Kotlin + JDBC", "JdbcExperimentRepository,\nJdbcModelTemplateRepository,\nJdbcComparisonRepository. Паттерн Repository.")
}

Rel(spa, controllers, "REST-запросы", "JSON / HTTP")
Rel(controllers, services, "Вызывает методы сервисов")
Rel(controllers, exHandler, "Исключения перехватываются")
Rel(beansConfig, services, "Создаёт и связывает")
Rel(beansConfig, repositories, "Создаёт и связывает")
Rel(services, simulation, "Запускает ОДУ-симуляцию")
Rel(services, validation, "Валидирует параметры")
Rel(services, repositories, "Читает / сохраняет (через интерфейсы домена)")
Rel(repositories, db, "SQL-запросы", "JDBC")

@enduml
