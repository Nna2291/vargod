@startuml c4_l3_component_frontend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Component.puml

SHOW_LEGEND()

title Vargod — L3: Компоненты Веб-GUI (React SPA, паттерн MVVM)

Container(api, "API-сервер", "Kotlin, Spring Boot", "Бэкенд (REST)")

Container_Boundary(spa, "Веб-GUI") {
    Component(view, "View — страницы и компоненты", "React, TSX", "Страницы (каталог моделей, эксперименты,\nсравнения) и переиспользуемые компоненты\n(NavBar, ParameterForm, ResultChart, StatusBadge).\nТолько отображение и пользовательский ввод.")
    Component(viewmodel, "ViewModel — сторы и хуки", "Zustand, React-хуки", "Состояние UI и команды: sessionStore,\nuseCatalog, useExperiments, useComparisons.\nСвязующий слой между View и Model, без JSX.")
    Component(model, "Model — типы и API-клиент", "TypeScript, axios", "TS-типы доменных сущностей и типизированные\nобёртки REST-эндпоинтов. Единственный слой,\nобщающийся с API-сервером.")
}

Rel(view, viewmodel, "Читает состояние,\nвызывает команды")
Rel(viewmodel, model, "Запрашивает данные,\nотправляет изменения")
Rel(model, api, "REST-запросы", "JSON / HTTP")

@enduml
