@startuml c4_l4_repository
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
hide empty members

title Vargod — L4: Компонент доступа к данным (Repository Layer)

package "DB Entities (JPA)" #eef {
    class UserEntity {
        +id: UUID
        +email: String
        +name: String
        +role: UserRole
        +createdAt: Instant
    }

    class ModelTemplateEntity {
        +id: UUID
        +code: String
        +name: String
        +description: String?
        +solverType: String
    }

    class ExperimentEntity {
        +id: UUID
        +name: String?
        +status: ExperimentStatus
        +isPublic: Boolean
        +createdAt: Instant
    }

    class ParameterSetEntity {
        +id: UUID
        +values: String
        +tStart: Double
        +tEnd: Double
        +step: Double
    }

    class SimulationResultEntity {
        +id: UUID
        +data: String
        +createdAt: Instant
    }

    class DatasetEntity {
        +id: UUID
        +name: String
        +format: String
        +mimeType: String
        +sizeBytes: Long
        +originalFilename: String
        +storageKind: String
        +storageUrl: String?
        +data: ByteArray?
        +uploadedAt: Instant
    }

    class ValidatorEntity {
        +id: UUID
        +name: String
        +checkType: String
        +targetKind: String
        +targetField: String
        +rules: String
        +modelTemplateId: UUID?
        +datasetId: UUID?
    }

    class InterpolationEntity {
        +id: UUID
        +methodCode: String
        +kind: String
        +sourceColumn: String
        +parameters: String
        +resultData: String?
        +status: String
        +createdAt: Instant
    }

    class ValidationResultEntity {
        +id: UUID
        +status: String
        +message: String?
    }

    class ComparisonEntity {
        +id: UUID
        +name: String?
        +createdAt: Instant
    }

    ExperimentEntity "N" --> "1" UserEntity
    ExperimentEntity "N" --> "1" ModelTemplateEntity
    ExperimentEntity "1" --> "0..1" ParameterSetEntity
    ExperimentEntity "1" --> "0..1" SimulationResultEntity
    DatasetEntity "N" --> "1" UserEntity
    ValidatorEntity "N" --> "0..1" ModelTemplateEntity
    ValidatorEntity "N" --> "0..1" DatasetEntity
    ValidationResultEntity "N" --> "1" ValidatorEntity
    ComparisonEntity "N" --> "1" UserEntity
    ComparisonEntity "N" --> "M" ExperimentEntity
    InterpolationEntity "N" --> "1" DatasetEntity
    InterpolationEntity "N" --> "1" UserEntity
}

package "Repository Interfaces" #efe {
    interface ExperimentRepository {
        +findById(id: UUID): ExperimentEntity?
        +findAllByUserId(userId: UUID): List<ExperimentEntity>
        +findAllByIsPublicTrue(): List<ExperimentEntity>
        +save(entity: ExperimentEntity): ExperimentEntity
        +deleteById(id: UUID)
    }

    interface ModelTemplateRepository {
        +findAll(): List<ModelTemplateEntity>
        +findById(id: UUID): ModelTemplateEntity?
        +findValidatorsByModelId(id: UUID): List<ValidatorEntity>
    }

    interface DatasetRepository {
        +findById(id: UUID): DatasetEntity?
        +findAllByUserId(userId: UUID): List<DatasetEntity>
        +save(entity: DatasetEntity): DatasetEntity
    }

    interface ValidationResultRepository {
        +findAllByParameterSetId(id: UUID): List<ValidationResultEntity>
        +save(entity: ValidationResultEntity): ValidationResultEntity
    }

    interface ComparisonRepository {
        +findById(id: UUID): ComparisonEntity?
        +findAllByUserId(userId: UUID): List<ComparisonEntity>
        +save(entity: ComparisonEntity): ComparisonEntity
    }

    interface ValidatorRepository {
        +findAllByModelTemplateId(id: UUID): List<ValidatorEntity>
        +findAllByDatasetId(id: UUID): List<ValidatorEntity>
        +findAllByIds(ids: List<UUID>): List<ValidatorEntity>
        +save(entity: ValidatorEntity): ValidatorEntity
    }

    interface InterpolationRepository {
        +findById(id: UUID): InterpolationEntity?
        +findAllByUserId(userId: UUID): List<InterpolationEntity>
        +save(entity: InterpolationEntity): InterpolationEntity
    }

    ExperimentRepository ..> ExperimentEntity : <<manages>>
    ModelTemplateRepository ..> ModelTemplateEntity : <<manages>>
    DatasetRepository ..> DatasetEntity : <<manages>>
    ValidationResultRepository ..> ValidationResultEntity : <<manages>>
    ComparisonRepository ..> ComparisonEntity : <<manages>>
    ValidatorRepository ..> ValidatorEntity : <<manages>>
    InterpolationRepository ..> InterpolationEntity : <<manages>>
}

package "Domain Model" #fee {
    class Experiment {
        +id: UUID
        +name: String?
        +status: ExperimentStatus
        +isPublic: Boolean
        +userId: UUID
        +modelTemplateId: UUID
        +parameterSet: ParameterSet?
        +result: SimulationResult?
    }

    class ParameterSet {
        +id: UUID
        +values: Map<String, Double>
        +tStart: Double
        +tEnd: Double
        +step: Double
    }

    class SimulationResult {
        +id: UUID
        +timePoints: List<Double>
        +variables: Map<String, List<Double>>
    }

    enum ExperimentStatus {
        PENDING
        RUNNING
        COMPLETED
        FAILED
    }

    Experiment --> ParameterSet
    Experiment --> SimulationResult
    Experiment --> ExperimentStatus
}

package "DTO (Transport)" #ffe {
    class ExperimentDto {
        +id: UUID
        +name: String?
        +status: String
        +isPublic: Boolean
        +modelTemplateId: UUID
        +createdAt: String
    }

    class CreateExperimentRequest {
        +name: String?
        +modelTemplateId: UUID
        +parameters: Map<String, Double>
        +tStart: Double
        +tEnd: Double
        +step: Double
    }

    class SimulationResultDto {
        +experimentId: UUID
        +timePoints: List<Double>
        +variables: Map<String, List<Double>>
    }

    class DatasetMetadataDto {
        +id: UUID
        +name: String
        +format: String
        +mimeType: String
        +sizeBytes: Long
        +originalFilename: String
        +uploadedAt: String
    }

    class DatasetUploadResponse {
        +id: UUID
        +name: String
        +sizeBytes: Long
    }

    class InterpolationRequestDto {
        +datasetId: UUID
        +methodCode: String
        +sourceColumn: String
        +parameters: Map<String, Any>
        +columnValidatorIds: List<UUID>
    }

    class InterpolationDto {
        +id: UUID
        +datasetId: UUID
        +methodCode: String
        +kind: String
        +sourceColumn: String
        +status: String
        +result: InterpolationResultDto?
        +createdAt: String
    }

    class InterpolationResultDto {
        +xQuery: List<Double>
        +yPredicted: List<Double>
        +diagnostics: Map<String, Any>
    }
}

@enduml
