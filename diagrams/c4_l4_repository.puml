@startuml c4_l4_repository
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
hide empty members

title Vargod — L4: Компонент доступа к данным (Repository Layer, Lab 4)

package "Domain (com.vargod.domain)" #fee {
    class Experiment {
        +id: UUID
        +name: String?
        +status: ExperimentStatus
        +isPublic: Boolean
        +userId: UUID
        +modelTemplateId: UUID
        +parameterSet: ParameterSet?
        +result: SimulationResult?
        +createdAt: Instant
    }

    class ParameterSet {
        +id: UUID
        +values: Map<String, Double>
        +tStart: Double
        +tEnd: Double
        +step: Double
    }

    class SimulationResult {
        +id: UUID
        +timePoints: List<Double>
        +variables: Map<String, List<Double>>
        +createdAt: Instant
    }

    class ModelTemplate {
        +id: UUID
        +code: String
        +name: String
        +description: String?
        +solverType: String
        +validators: List<Validator>
    }

    class Validator {
        +id: UUID
        +name: String
        +checkType: ValidatorType
        +targetKind: ValidatorTargetKind
        +targetField: String
        +rules: Map<String, Any>
    }

    class Comparison {
        +id: UUID
        +name: String?
        +userId: UUID
        +experiments: List<Experiment>
        +createdAt: Instant
    }

    enum ExperimentStatus {
        PENDING
        RUNNING
        COMPLETED
        FAILED
    }

    class DomainException
    class PersistenceException

    Experiment "1" --> "0..1" ParameterSet
    Experiment "1" --> "0..1" SimulationResult
    Experiment --> ExperimentStatus
    ModelTemplate "1" --> "*" Validator
    Comparison "1" --> "*" Experiment
    PersistenceException --|> DomainException
}

package "Repository Interfaces (com.vargod.domain.repository)" #efe {
    interface ExperimentRepository {
        +findById(id: UUID): Experiment?
        +findAllByUserId(userId: UUID): List<Experiment>
        +findAllPublic(): List<Experiment>
        +findAllByIds(ids: List<UUID>): List<Experiment>
        +save(experiment: Experiment): Experiment
        +deleteById(id: UUID)
    }

    interface ModelTemplateRepository {
        +findAll(): List<ModelTemplate>
        +findById(id: UUID): ModelTemplate?
    }

    interface ComparisonRepository {
        +findById(id: UUID): Comparison?
        +findAllByUserId(userId: UUID): List<Comparison>
        +save(comparison: Comparison): Comparison
    }

    ExperimentRepository ..> Experiment : <<manages>>
    ModelTemplateRepository ..> ModelTemplate : <<manages>>
    ComparisonRepository ..> Comparison : <<manages>>
}

package "JDBC Implementations (com.vargod.repository.jdbc)" #eef {
    class JdbcExperimentRepository {
        -dataSource: DataSource
        -codec: JsonCodec
        +findById/findAll*/save/deleteById(...)
    }

    class JdbcModelTemplateRepository {
        -dataSource: DataSource
        -codec: JsonCodec
        +findAll/findById(...)
    }

    class JdbcComparisonRepository {
        -dataSource: DataSource
        -experimentRepository: ExperimentRepository
        +findById/findAllByUserId/save(...)
    }

    class DataSourceFactory <<object>> {
        +postgres(url, user, pwd): DataSource
    }

    class SchemaInitializer {
        -dataSource: DataSource
        +initialize()
    }

    class JsonCodec {
        +encode(value: Any): String
        +decodeDoubleMap(json: String): Map<String,Double>
        +decodeAnyMap(json: String): Map<String,Any>
        +encodeSimulationData(...)/decodeSimulationData(...)
    }

    class ResultSetMappers <<extensions>> {
        +ResultSet.readExperimentRow()
        +ResultSet.readParameterSet(codec)
        +ResultSet.readSimulationResult(codec)
        +ResultSet.readValidator(codec)
        +ResultSet.readModelTemplate(validators)
    }

    JdbcExperimentRepository ..|> ExperimentRepository
    JdbcModelTemplateRepository ..|> ModelTemplateRepository
    JdbcComparisonRepository ..|> ComparisonRepository

    JdbcExperimentRepository --> JsonCodec
    JdbcExperimentRepository --> ResultSetMappers
    JdbcModelTemplateRepository --> JsonCodec
    JdbcModelTemplateRepository --> ResultSetMappers
    JdbcComparisonRepository --> ExperimentRepository
}

interface "javax.sql.DataSource" as DataSource <<JDK>>

JdbcExperimentRepository --> DataSource
JdbcModelTemplateRepository --> DataSource
JdbcComparisonRepository --> DataSource
DataSourceFactory ..> DataSource
SchemaInitializer --> DataSource

note bottom of "Repository Interfaces (com.vargod.domain.repository)"
  Интерфейсы вынесены в пакет домена (Lab 4, §3):
  доступ к данным зависит от бизнес-логики,
  а не наоборот (Ports & Adapters / DIP).
end note

note right of PersistenceException
  Слой данных оборачивает SQLException
  в PersistenceException (наследник DomainException),
  чтобы вышестоящие слои не зависели от JDBC.
end note

@enduml
